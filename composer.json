{
    "name": "nodda/client",
    "description": "Cliente oficial de la API de Nodda para emitir y consultar facturas VERI*FACTU (AEAT).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "verifactu",
        "aeat",
        "facturacion",
        "factura",
        "nodda"
    ],
    "homepage": "https://app.nodda.es/developers/introduccion",
    "authors": [
        {
            "name": "Nodda",
            "email": "soporte@nodda.es"
        }
    ],
    "support": {
        "email": "soporte@nodda.es"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "NoddaClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoddaClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
